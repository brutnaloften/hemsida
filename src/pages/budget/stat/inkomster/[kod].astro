---
import type { GetStaticPaths } from 'astro';
import LeafDetail from '@/components/budget/LeafDetail.astro';
import RevenueDrillPage from '@/components/budget/RevenueDrillPage.astro';
import { latestYear } from '@/lib/budget/data';
import { pathTo, type BudgetNode } from '@/lib/budget/core';
import { buildRevenueTree } from '@/lib/budget/view';

// One page for every revenue node: Skatter, netto, typ, huvudgrupp and titelgrupp drill pages, and a
// leaf page (LeafDetail) for every titel.
export const getStaticPaths = (() => {
  const root = buildRevenueTree(latestYear);
  const paths: {
    params: { kod: string };
    props: { id: string; leaf: boolean; chain: BudgetNode[]; sideTotal: number };
  }[] = [];
  const walk = (n: BudgetNode) => {
    for (const c of n.children ?? []) {
      const leaf = c.kind === 'leaf';
      paths.push({
        params: { kod: c.id.replace(/^rev:/, '') },
        props: {
          id: c.id,
          leaf,
          chain: leaf ? [] : pathTo(root, c.id)!,
          sideTotal: root.value ?? 0,
        },
      });
      walk(c);
    }
  };
  walk(root);
  return paths;
}) satisfies GetStaticPaths;

const { id, leaf, chain, sideTotal } = Astro.props;
---

{leaf ? <LeafDetail nodeId={id} /> : <RevenueDrillPage chain={chain} sideTotal={sideTotal} />}
