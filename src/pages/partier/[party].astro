---
import Redirect from '@/components/Redirect.astro';
import { PARTIES } from '@/schema/promise';
import { getDefaultTerm } from '@/lib/term-data';
import { termPagePath } from '@/lib/terms';

export const getStaticPaths = () => PARTIES.map((p) => ({ params: { party: p.toLowerCase() } }));

const term = await getDefaultTerm();
const { party } = Astro.params;
---

<Redirect to={termPagePath('party', term, party)} />
