---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PeriodBar from '../components/PeriodBar.astro';
import type { PageKind } from '../lib/terms';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute canonical URL, for pages that are reachable under more than one path. */
  canonical?: string;
  /** Renders the period bar under the header; set on term-dependent pages only. */
  period?: { kind: PageKind; term: string; param?: string; subtitles?: Record<string, string> };
}

const {
  canonical,
  period,
  title = 'Brutna Löften',
  description = 'En databas som spårar och analyserar politiska löften i Sverige. Se vilka politiker som lever upp till sina ord.',
} = Astro.props;
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    {canonical && <link rel="canonical" href={canonical} />}
    <base href={import.meta.env.BASE_URL} />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
      <Navbar />
      {period && <PeriodBar {...period} />}
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
