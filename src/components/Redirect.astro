---
/**
 * Thin stub for an old URL. GitHub Pages has no redirects, so the page carries a
 * canonical link, a meta refresh and a visible link. `to` is site-relative.
 */
interface Props {
  to: string;
}
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const target = new URL(`${base}${Astro.props.to}`, Astro.site).href;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sidan har flyttat — Brutna Löften</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>Sidan har flyttat. <a href={target}>Fortsätt till den nya adressen</a>.</p>
  </body>
</html>
