---
import ThemeToggle from './ThemeToggle';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const links = [
  { href: `${base}partier`, label: 'Partier' },
  { href: `${base}om-metoden`, label: 'Om metoden' },
  { href: `${base}search`, label: 'Sök' },
];
---

<!-- Push content below fixed header -->
<div class="mt-14 md:mt-16"></div>
<header class="fixed top-0 left-0 right-0 bg-background border-b shadow-sm z-50">
  <nav aria-label="Huvudnavigering" class="container mx-auto px-4 md:px-6 flex items-center justify-between h-14 md:h-16">
    <a href={base} class="font-bold text-lg md:text-xl whitespace-nowrap">
      Brutna Löften
    </a>
    <div class="flex items-center gap-4">
      <ul class="hidden md:flex items-center gap-4">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="text-sm whitespace-nowrap text-muted-foreground hover:text-foreground transition-colors">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle client:load />
      <button
        type="button"
        id="nav-toggle"
        class="md:hidden text-muted-foreground hover:text-foreground transition-colors"
        aria-label="Meny"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <svg class="nav-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="nav-icon-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>
  <div id="nav-menu" class="hidden md:hidden border-t bg-background">
    <ul class="container mx-auto px-4 py-2">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block py-3 text-base text-foreground">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.nav-icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.nav-icon-close')?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  // Close when the viewport grows past the breakpoint so the menu is never stuck open.
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
