---
import Layout from '@/layouts/Layout.astro';
import AboutNumbers from '@/components/budget/AboutNumbers.astro';
import BudgetExplorer from '@/components/budget/BudgetExplorer';
import { latestYear } from '@/lib/budget/data';
import { buildBalance, levelHref, withoutChildren, yearOptions } from '@/lib/budget/view';

// /budget/ and /budget/stat/ render the same page; the canonical one is /budget/stat/.
const canonical = new URL(levelHref(), Astro.site).href;
const balance = withoutChildren(buildBalance(latestYear));
---

<Layout
  title={`Statens budget ${latestYear} – Brutna Löften`}
  description="Vad staten gav ut och tog in, och vad som blev över eller saknades. Statens budget i ett diagram, med utfall från Ekonomistyrningsverket."
  canonical={canonical}
>
  <div class="container mx-auto max-w-5xl px-4 py-6 md:px-6">
    <BudgetExplorer client:idle initial={balance} years={yearOptions()} />
    <AboutNumbers />
  </div>
</Layout>
