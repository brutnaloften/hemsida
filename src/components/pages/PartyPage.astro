---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import VerdictCounts from '@/components/VerdictCounts.astro';
import PartyPromiseList from '@/components/PartyPromiseList';
import { partyName } from '@/lib/promise-labels';
import PartyOutcomeCounts from '@/components/PartyOutcomeCounts.astro';
import { agreementOutcomeCounts, areaCounts, promisesForParty, sortByTitle } from '@/lib/party-stats';
import { promisePath } from '@/lib/timeline';
import { getTerms } from '@/lib/term-data';
import { ROLE_LABELS, partyRole, termOfFilePath, termPagePath } from '@/lib/terms';
import { agreementName } from '@/schema/promise';

interface Props {
  term: string;
  /** Upper-case party id, e.g. "M". */
  party: string;
}

const { term, party } = Astro.props;
const all = (await getCollection('promises'))
  .filter((e) => termOfFilePath(e.filePath ?? '') === term)
  .map((e) => e.data);
const promises = promisesForParty(all, party);
const agreement = (await getCollection('sources')).map((e) => e.data).find((s) => s.id === 'tidoavtalet');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const rows = sortByTitle(promises).map((p) => ({
  id: p.id,
  title: p.title,
  area: p.area,
  verdict: { value: p.verdict.value },
  href: `${base}${promisePath(p.id)}`,
}));
const areas = areaCounts(promises).map((a) => a.area);
const name = partyName(party);
const outcome = agreementOutcomeCounts(promises);

// The party's role per term replaces per-term tabs: it is the period bar subtitle.
const terms = await getTerms();
const subtitles: Record<string, string> = {};
for (const t of terms) {
  const role = partyRole(t, party);
  if (role) subtitles[t.id] = ROLE_LABELS[role];
}
const role = subtitles[term];
const other = terms.filter((t) => t.id !== term && t.promiseCount > 0).at(-1);
---

<Layout
  title={`${name} — Brutna Löften`}
  description={`Löften från ${name} och hur långt de bedömts.`}
  period={{ kind: 'party', term, param: party, subtitles }}
>
  <div class="container mx-auto max-w-3xl px-4 py-8 md:px-6 md:py-12">
    <a href={`${base}${termPagePath('partier', term)}`} class="text-sm text-muted-foreground hover:text-foreground">&larr; Alla partier</a>
    <h1 class="mt-4 text-2xl font-bold tracking-tight md:text-4xl">{name}</h1>
    {role && <p class="mt-2 text-muted-foreground">{role} {term}</p>}
    {
      promises.length === 0 ? (
        <section class="mt-8">
          <p>Inga löften insamlade för {name} under {term}.</p>
          {other && (
            <p class="mt-2">
              <a href={`${base}${termPagePath('party', other.id, party)}`} class="underline underline-offset-2">
                Se {name} {other.id}
              </a>
            </p>
          )}
        </section>
      ) : (
        <>
          <section class="mt-6">
            <h2 class="text-xl font-semibold">Bedömningar</h2>
            <div class="mt-3"><VerdictCounts promises={rows} /></div>
            <p class="mt-3 text-sm text-muted-foreground">
              Löften som flera partier står bakom räknas för varje parti.
            </p>
          </section>
          {outcome.total > 0 && agreement && (
            <section class="mt-10">
              <h2 class="text-xl font-semibold">Valmanifest och {agreementName(agreement)}</h2>
              <div class="mt-3">
                <PartyOutcomeCounts counts={outcome.counts} total={outcome.total} source={agreement} />
              </div>
            </section>
          )}
          <section class="mt-10">
            <h2 class="mb-3 text-xl font-semibold">Löften</h2>
            <PartyPromiseList client:load promises={rows} areas={areas} />
          </section>
        </>
      )
    }
  </div>
</Layout>
