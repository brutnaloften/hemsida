---
import { verdictBarSegments, verdictAriaLabel } from '@/lib/party-stats';
import type { VERDICTS } from '@/schema/promise';

interface Props {
  counts: Record<(typeof VERDICTS)[number], number>;
  total: number;
  /** Tailwind classes for the bar track (height, margin). */
  class?: string;
  /** Hide from assistive tech when the same numbers are in the text beside the bar. */
  decorative?: boolean;
}
const { counts, total, class: cls = 'h-2.5', decorative = false } = Astro.props;
const segments = verdictBarSegments(counts);
const pct = (n: number) => `${(n / total) * 100}%`;
// Only a still-unjudged share is hatched; a finished term has a plain, fully coloured bar.
const hatch =
  'background-image:repeating-linear-gradient(135deg,hsl(var(--muted)) 0 4px,hsl(var(--background)) 4px 8px);';
---

<div
  class:list={['flex w-full overflow-hidden rounded-full border bg-muted', cls]}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : verdictAriaLabel(total, counts)}
  aria-hidden={decorative ? 'true' : undefined}
>
  {
    segments.map((seg) => (
      <div
        style={`width:${pct(seg.n)};background:var(--verdict-${seg.verdict}-bar);border-right:1px solid hsl(var(--background));${seg.verdict === 'unassessed' ? hatch : ''}`}
      />
    ))
  }
</div>
