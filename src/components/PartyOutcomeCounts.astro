---
import { Badge } from '@/components/ui/badge';
import { AGREEMENT_OUTCOMES, agreementName, agreementOutcomeLabel } from '@/schema/promise';
import { AGREEMENT_OUTCOME_STYLE } from '@/lib/promise-labels';
import type { AgreementOutcome } from '@/schema/promise';

interface Props {
  counts: Record<AgreementOutcome, number>;
  total: number;
  /** The compared agreement's source; its name is used in the labels. */
  source: { shortTitle?: string; title: string };
}
const { counts, total, source } = Astro.props;
const name = agreementName(source);
---

{
  total > 0 && (
    <>
      <p class="text-sm text-muted-foreground">
        {total} löften i partiets valmanifest har jämförts med {name}. Det beskriver vad texten säger, inte om löftet
        hållits.
      </p>
      <ul class="mt-3 flex flex-wrap gap-2" aria-label={`Löften per utfall i ${name}`}>
        {AGREEMENT_OUTCOMES.map((o) => (
          <li>
            <Badge variant="outline" className={AGREEMENT_OUTCOME_STYLE} data-outcome={o}>
              {agreementOutcomeLabel(o, source)}: {counts[o]}
            </Badge>
          </li>
        ))}
      </ul>
    </>
  )
}
