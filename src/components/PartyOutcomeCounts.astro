---
import { Badge } from '@/components/ui/badge';
import { AGREEMENT_OUTCOMES, AGREEMENT_OUTCOME_LABELS } from '@/schema/promise';
import { AGREEMENT_OUTCOME_STYLE } from '@/lib/promise-labels';
import type { AgreementOutcome } from '@/schema/promise';

interface Props {
  counts: Record<AgreementOutcome, number>;
  total: number;
}
const { counts, total } = Astro.props;
---

{
  total > 0 && (
    <>
      <p class="text-sm text-muted-foreground">
        {total} löften i partiets valmanifest har jämförts med Tidöavtalet. Det beskriver vad avtalets text säger, inte om
        löftet hållits.
      </p>
      <ul class="mt-3 flex flex-wrap gap-2" aria-label="Löften per utfall i avtalet">
        {AGREEMENT_OUTCOMES.map((o) => (
          <li>
            <Badge variant="outline" className={AGREEMENT_OUTCOME_STYLE} data-outcome={o}>
              {AGREEMENT_OUTCOME_LABELS[o]}: {counts[o]}
            </Badge>
          </li>
        ))}
      </ul>
    </>
  )
}
