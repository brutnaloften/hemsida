---
import { VerdictBadge } from '@/components/ui/verdict-badge';
import VerdictBar from '@/components/VerdictBar.astro';
import { BAR_ORDER, verdictCounts, verdictSummaryText, type PartyPromise } from '@/lib/party-stats';

interface Props {
  promises: Pick<PartyPromise, 'verdict'>[];
}
const { promises } = Astro.props;
const counts = verdictCounts(promises);
const total = promises.length;
const legend = BAR_ORDER.filter((v) => counts[v] > 0);
---

<p class="text-sm text-muted-foreground">{verdictSummaryText(total, counts)}</p>
<VerdictBar counts={counts} total={total} class="mt-3 h-3" />
<ul class="mt-4 flex flex-wrap gap-2" aria-label="Förklaring">
  {
    legend.map((v) => (
      <li>
        <VerdictBadge verdict={v} suffix={String(counts[v])} />
      </li>
    ))
  }
</ul>
